# ============================================
# Hofflohmarkt – Konfigurationsdatei
# ============================================
# Kopiere diese Datei nach .env und passe die Werte an.

# Geheimnis für die Express-Session (beliebiger langer String)
SESSION_SECRET=mein-super-geheimes-session-secret-hier-aendern

# Admin-Zugangsdaten (werden beim ersten Start angelegt)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=mein-sicheres-passwort

# Port, auf dem der Server lauscht (Standard: 3000)
PORT=3000
