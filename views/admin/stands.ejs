<% locals.needsMap = false; %>
<%- include('../partials/header') %>

<section class="admin-section">
  <div class="section-header">
    <h1>Stände &ndash; <%= market.name %></h1>
    <a href="/admin/markets" class="btn btn-secondary">&larr; Zurück zur Marktübersicht</a>
  </div>

  <%# Meldungen werden bereits im partials/header.ejs über res.locals angezeigt %>
  <%# Hier nur den Bestätigungs-Dialog für Außerhalb-Adressen anzeigen %>

  <% if (typeof outsideWarningPending !== 'undefined' && outsideWarningPending && outsideWarning) { %>
    <div class="alert alert-warning" style="border-left: 4px solid #f59e0b; background: #fffbeb;">
      <strong>⚠️ Adresse außerhalb des Marktgebiets</strong><br>
      Die Adresse <strong><%= outsideWarning.fullAddress %></strong> liegt außerhalb des eingezeichneten Marktgebiets.
      Soll der Stand trotzdem eingetragen werden?
      <form action="/admin/markets/<%= market.id %>/stands/add" method="POST"
            style="display:inline; margin-left: 1rem;">
        <input type="hidden" name="street" value="">
        <input type="hidden" name="housenumber" value="">
        <input type="hidden" name="zip" value="">
        <input type="hidden" name="name" value="<%= outsideWarning.name %>">
        <input type="hidden" name="directions" value="<%= outsideWarning.directions %>">
        <input type="hidden" name="force" value="yes">
        <input type="hidden" name="force_address" value="<%= outsideWarning.fullAddress %>">
        <input type="hidden" name="force_lat" value="<%= outsideWarning.lat %>">
        <input type="hidden" name="force_lon" value="<%= outsideWarning.lon %>">
        <% (outsideWarning.categories || []).forEach(cat => { %>
          <input type="hidden" name="categories" value="<%= cat %>">
        <% }) %>
        <button type="submit" class="btn btn-small btn-warning" style="background:#f59e0b;color:#fff;border:none;">
          Ja, trotzdem eintragen
        </button>
      </form>
      <form action="/admin/markets/<%= market.id %>/stands" method="GET" style="display:inline; margin-left:0.5rem;">
        <button type="submit" class="btn btn-small btn-secondary">Abbrechen</button>
      </form>
    </div>
  <% } %>

  <!-- Stand hinzufügen -->
  <div class="admin-card" style="margin-bottom:2rem">
    <h2>Stand hinzufügen</h2>
    <form action="/admin/markets/<%= market.id %>/stands/add" method="POST" class="inline-form">
      <div class="form-row">
        <div class="form-group flex-2">
          <label>Straße *</label>
          <input type="text" name="street" required placeholder="Musterstraße">
        </div>
        <div class="form-group flex-1">
          <label>Hausnummer *</label>
          <input type="text" name="housenumber" required placeholder="42">
        </div>
        <div class="form-group flex-1">
          <label>PLZ</label>
          <input type="text" name="zip" placeholder="12345">
        </div>
      </div>
      <div class="form-row">
        <div class="form-group flex-2">
          <label>Name / Standbezeichnung</label>
          <input type="text" name="name" placeholder="z. B. Familie Müller">
        </div>
        <div class="form-group flex-2">
          <label>Wegbeschreibung</label>
          <input type="text" name="directions" placeholder="z. B. Hinterhof, 2. Eingang links">
        </div>
      </div>
      <% if (market.categoriesParsed && market.categoriesParsed.length > 0) { %>
        <div class="form-group">
          <label>Kategorien</label>
          <div class="checkbox-group">
            <% market.categoriesParsed.forEach(cat => { %>
              <label class="checkbox-label">
                <input type="checkbox" name="categories" value="<%= cat %>"> <%= cat %>
              </label>
            <% }) %>
          </div>
        </div>
      <% } %>
      <button type="submit" class="btn btn-primary">Stand hinzufügen &amp; Code generieren</button>
    </form>
  </div>

  <!-- Stände-Tabelle -->
  <% if (stands.length === 0) { %>
    <p class="empty-state">Für diesen Markt sind noch keine Stände angemeldet.</p>
  <% } else { %>
    <p><strong><%= stands.length %></strong> Stand/Stände angemeldet.</p>
    <div class="table-responsive">
      <table class="admin-table">
        <thead>
          <tr>
            <th>ID</th>
            <th>Adresse</th>
            <th>Name</th>
            <th>Wegbeschreibung</th>
            <th>Kategorien</th>
            <th>Code</th>
            <th>Angemeldet am</th>
            <th>Aktionen</th>
          </tr>
        </thead>
        <tbody>
          <% stands.forEach(stand => { %>
            <tr id="row-<%= stand.id %>">
              <td><%= stand.id %></td>
              <td><%= stand.address %></td>
              <td><%= stand.name || '' %></td>
              <td><%= stand.directions || '' %></td>
              <td>
                <% if (stand.categoriesParsed.length > 0) { %>
                  <% stand.categoriesParsed.forEach(cat => { %>
                    <span class="category-tag small"><%= cat %></span>
                  <% }) %>
                <% } %>
              </td>
              <td>
                <% if (stand.edit_code) { %>
                  <code class="edit-code"><%= stand.edit_code %></code>
                <% } %>
              </td>
              <td><small><%= stand.createdFormatted %></small></td>
              <td class="action-cell">
                <button type="button" class="btn btn-small btn-secondary"
                        onclick="toggleEdit(<%= stand.id %>)">Bearbeiten</button>
                <form action="/admin/markets/<%= market.id %>/stands/<%= stand.id %>/delete" method="POST"
                      style="display:inline" onsubmit="return confirm('Stand wirklich löschen?');">
                  <button type="submit" class="btn btn-small btn-danger">Löschen</button>
                </form>
              </td>
            </tr>
            <tr id="edit-<%= stand.id %>" class="edit-row" style="display:none">
              <td colspan="8">
                <form action="/admin/markets/<%= market.id %>/stands/<%= stand.id %>/edit" method="POST"
                      class="inline-edit-form">
                  <div class="form-row">
                    <%
                      // Adresse aufteilen: "Straße Hausnr, PLZ"
                      const addrParts = (stand.address || '').split(',');
                      const streetPart = (addrParts[0] || '').trim();
                      const zipPart = (addrParts[1] || '').trim();
                      const streetWords = streetPart.split(' ');
                      const houseEdit = streetWords.pop() || '';
                      const streetEdit = streetWords.join(' ');
                    %>
                    <div class="form-group flex-2">
                      <label>Straße</label>
                      <input type="text" name="street" value="<%= streetEdit %>"
                             placeholder="Musterstraße">
                    </div>
                    <div class="form-group flex-1">
                      <label>Hausnummer</label>
                      <input type="text" name="housenumber" value="<%= houseEdit %>"
                             placeholder="42">
                    </div>
                    <div class="form-group flex-1">
                      <label>PLZ</label>
                      <input type="text" name="zip" value="<%= zipPart %>"
                             placeholder="12345">
                    </div>
                  </div>
                  <div class="form-row">
                    <div class="form-group flex-2">
                      <label>Name</label>
                      <input type="text" name="name" value="<%= stand.name || '' %>"
                             placeholder="z. B. Familie Müller">
                    </div>
                    <div class="form-group flex-2">
                      <label>Wegbeschreibung</label>
                      <input type="text" name="directions" value="<%= stand.directions || '' %>"
                             placeholder="z. B. Hinterhof">
                    </div>
                  </div>
                  <% if (market.categoriesParsed && market.categoriesParsed.length > 0) { %>
                    <div class="form-group">
                      <label>Kategorien</label>
                      <div class="checkbox-group">
                        <% market.categoriesParsed.forEach(cat => { %>
                          <label class="checkbox-label">
                            <input type="checkbox" name="categories" value="<%= cat %>"
                              <%= stand.categoriesParsed.includes(cat) ? 'checked' : '' %>>
                            <%= cat %>
                          </label>
                        <% }) %>
                      </div>
                    </div>
                  <% } %>
                  <div class="form-actions" style="margin-top:0.75rem">
                    <button type="submit" class="btn btn-small btn-primary">Speichern</button>
                    <button type="button" class="btn btn-small btn-secondary"
                            onclick="toggleEdit(<%= stand.id %>)">Abbrechen</button>
                  </div>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>

<script>
function toggleEdit(id) {
  var editRow = document.getElementById('edit-' + id);
  var dispRow = document.getElementById('row-' + id);
  var hidden  = editRow.style.display === 'none';
  editRow.style.display = hidden ? 'table-row' : 'none';
  dispRow.style.background = hidden ? '#eef4ff' : '';
}
</script>

<%- include('../partials/footer') %>
